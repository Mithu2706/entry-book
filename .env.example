# ============================================
# Entry Book - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control

# ============================================
# Supabase Configuration
# ============================================

# Your Supabase project URL (found in Settings > API)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anonymous/public key (safe for client-side use)
SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase service role key (NEVER expose in mobile app or client-side code)
# Only used in admin dashboard server-side operations
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ============================================
# Mobile App (Expo)
# ============================================
# These are prefixed with EXPO_PUBLIC_ to be accessible in the Expo app
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ============================================
# Admin Dashboard (Next.js)
# ============================================
# Public variables (accessible in browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only variables
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
